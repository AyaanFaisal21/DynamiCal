# Copy this file to .env and fill in the values. Do not commit .env.

# Model provider: gemini, local, or none.
#   gemini  cloud model, needs GEMINI_API_KEY. Get a key at https://aistudio.google.com/apikey
#   local   any OpenAI-compatible server: Ollama, llama.cpp llama-server, or mlx_lm.server
#   none    no model calls. Calendar attachments still work.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_API_KEY=ollama

# Your identity. The classifier uses these to tell personal mail from bulk mail.
USER_EMAIL=you@example.com
USER_PROFILE=Undergraduate CS student at Rutgers. Cares about exams, assignments, and research deadlines.
TRUSTED_DOMAINS=rutgers.edu,scarletmail.rutgers.edu

# Time zone for display and for dates in emails that do not say one.
DYNAMICAL_TIMEZONE=America/New_York

# Storage. Relative paths resolve against the repo root.
DYNAMICAL_DB=./data/dynamical.db

# Gmail OAuth. See README for how to create credentials.json.
GMAIL_CREDENTIALS=./secrets/credentials.json
GMAIL_TOKEN=./secrets/token.json
GMAIL_QUERY=newer_than:30d -in:spam -in:trash -category:promotions -category:social
GMAIL_MAX_MESSAGES=200

# Background sync inside the API server. 0 disables it.
SYNC_INTERVAL_MINUTES=0

# Day bounds for free-time search, in local hours.
DAY_START_HOUR=8
DAY_END_HOUR=23

# Decision thresholds for extracted events.
AUTO_ADD_THRESHOLD=0.75
PROPOSE_THRESHOLD=0.4
